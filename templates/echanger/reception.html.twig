{% extends 'base.html.twig' %}

{% block title %}Ma messagerie{% endblock %}

{% block body %}
<main class="messagerie-page">

    <h1 class="messagerie-titre">Ma messagerie</h1>

    {% if conversations is not empty %}
        <section class="messagerie-liste">

            {% for cle, conversation in conversations %}
                <article class="messagerie-item">
                    <a href="{{ path('app_message_conversation', {
                        annonceId: conversation.annonce.id,
                        expediteurId: conversation.autreUtilisateur.id
                    }) }}" class="messagerie-lien">

                        <h2 class="messagerie-annonce">
                            {{ conversation.annonce.titre }}
                        </h2>

                        <p class="messagerie-apercu">
                            {{ conversation.dernierMessage.message|slice(0, 120) ~ '...' }}
                        </p>

                    </a>
                </article>
            {% endfor %}

        </section>
    {% else %}
        <p class="messagerie-vide">Vous n’avez encore aucun message.</p>
    {% endif %}

</main>
{% endblock %}