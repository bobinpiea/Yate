{% extends 'base.html.twig' %}

{% block title %}Forum{% endblock %}

{% block body %}
  <div class="forum-container">
      
      <!-- Colonne gauche : Catégories -->
        <aside class="forum-categories">
            <h2>Catégories</h2>
            <ul>
                {% for categorie in categories %}
                    <li>{{ categorie.nom }}</li>
                {% endfor %}
            </ul>
        </aside>

      <!-- Colonne Centre : Sujet-->
        <main class="forum-subjects">
            <h2>Sujets</h2>

        </main>
        
  </div>
{% endblock %}