{% extends 'base.html.twig' %}

{% block title %}Forum{% endblock %}

{% block body %}

  <main class="forum-container">
      
      <!-- Colonne gauche : Catégories -->
        <aside class="forum-categories">
            <h2> <a href=" {{ path('app_forum')}}">Catégorie</a> </h2>

              <ul>
                {% for categorie in categories %}
                  <li>
                    <a href="{{ path('app_forum_sujets', {id: categorie.id}) }}">{{ categorie.nom }} </a>
                  </li>
                {% endfor %}
              </ul>
        </aside>

      <!-- Colonne Centre : Sujet-->
        <section class="forum-sujets">
          <div class="sujet-header">
            <h2>Sujets</h2>
            <a href="{{ path('app_forum_sujet_new') }} " class="btn-new-sujet" >Créer un sujet</a>      
          </div>
            <ul>
              {% for sujet in sujets %}
                <li>
                  <a href="{{ path('app_forum_sujet_show', { id: sujet.id }) }}">{{ sujet.titre }}</a>

                 {% if app.user and sujet.auteur and app.user.id == sujet.auteur.id %}
                  <a href="{{ path('app_forum_sujet_edit', { id: sujet.id }) }}" class="btn-edit-sujet"> Modifier </a>
                {% endif %} 
                
                </li>
              {% else %}
                <li>Aucun sujet pour le moment.</li>
              {% endfor %}
            </ul>
        </section>
        
  </main>
{% endblock %}