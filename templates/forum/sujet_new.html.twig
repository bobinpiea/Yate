{% extends 'base.html.twig' %}

{% block title %}Créer un sujet{% endblock %}

{% block body %}
  <div class="sujet-formulaire">
      <h1>Créer un sujet</h1>

      {{ form_start(form) }}
        {{ form_row(form.titre) }}
        {{ form_row(form.categorie) }}
        {{ form_row(form.premierMessage) }}
        
        <button type="submit">Publier</button>
      {{ form_end(form) }}
  </div>
{% endblock %}