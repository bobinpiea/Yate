{% extends 'base.html.twig' %}

{% block title %}Nouveau Sujet{% endblock %}

{% block body %}
  <h1>Créer un nouveau sujet dans {{ categorie.nom }}</h1>

  <div class="formulaire-sujet">
    {{ form_start(form) }}

      <div class="champ-formulaire">
        {{ form_label(form.titre, "Titre du sujet") }}
        {{ form_widget(form.titre, {'attr': {'class': 'input input--lg'}}) }}
        {{ form_errors(form.titre) }}
      </div>

      <div class="actions">
        <button type="submit" class="btn-submit">Publier</button>
      </div>

    {{ form_end(form) }}
  </div>
{% endblock %}