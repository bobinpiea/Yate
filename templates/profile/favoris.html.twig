{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<main class="bloc-profil">
    {% if user %}
    
         <h1 class="titre-profil">Mon profil</h1>
         
        <div class="entete-profil">
            <div class="photo-profil">
                {% if user.avatar %}
                    <img src="{{ user.avatar }}" alt="Avatar de {{ user.pseudo ?? user.email }}">
                {% else %}
                    <span class="image-defaut">A faire</span>
                {% endif %}
            </div>

         

            <div class="bouton-modif-profil">
                <a href="{{ path('app_profile_edit') }}">Éditer mon profil</a>
            </div>
        </div>

        <div class="infos-profil">
            <p><strong>Email :</strong> {{ user.email }}</p>
            <p><strong>Nom :</strong> {{ user.nom ?? 'Non renseigné' }}</p>
            <p><strong>Prénom :</strong> {{ user.prenom ?? 'Non renseigné' }}</p>
            <p><strong>Pseudo :</strong> {{ user.pseudo ?? 'Non renseigné' }}</p>
        </div>

        <section class="bloc-annonces-profil">
            <div class="entete-annonces-profil">
                <h2>Mes annonces</h2>
  
            </div>

            <div class="grille-annonces-profil">
                {% if annonces is not empty %}
                    {% for annonce in annonces %}
                        <div class="carte-annonce-profil">
                            <a href="{{ path('annonce_show', {id: annonce.id}) }}" class="lien-annonce-profil">
                                <div class="visuel-annonce-profil">
                                    {% if annonce.photos|length > 0 %}
                                        <img src="{{ asset('uploads/annonces/' ~ annonce.photos|first.url) }}"
                                             alt="Photo de {{ annonce.titre }}"
                                             style="width:100%; height:100%; object-fit:cover; border-radius:8px;">
                                    {% endif %}
                                </div>
                                <div class="details-annonce-profil">
                                    <p><strong>{{ annonce.ville }} – {{ annonce.commune }}</strong></p>
                                    <p>
                                        {% if annonce.superficie %}
                                            <strong>{{ annonce.superficie }} m²</strong> |
                                        {% endif %}
                                        <strong>{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</strong>
                                    </p>
                                </div>
                            </a>

                            <div class="actions-annonce-profil">
                                <a href="{{ path('app_annonce_edit', {id: annonce.id}) }}" class="lien-modifier">Modifier</a>
                                <form method="post" action="{{ path('app_annonce_delete', {id: annonce.id}) }}"
                                      onsubmit="return confirm('Voulez-vous vraiment supprimer cette annonce ?');"
                                      style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ annonce.id) }}">
                                    <button type="submit" class="bouton-supprimer">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <p>Vous n’avez pas encore publié d’annonce.</p>
                {% endif %}
            </div>

        <div class="bloc-favoris-profil" style="margin-top: 3rem;">
            <div class="entete-favoris-profil">
                <h2>Mes favoris</h2>
            </div>

            <div class="grille-annonces-profil">
                {% for fav in favoris %}
                    <div class="carte-annonce-profil">
                        <a href="{{ path('annonce_show', {id: fav.id}) }}" class="lien-annonce-profil">
                            <div class="visuel-annonce-profil">
                                {% if fav.photos|length > 0 %}
                                    <img src="{{ asset('uploads/annonces/' ~ fav.photos|first.url) }}"
                                        alt="Photo de {{ fav.titre }}"
                                        style="width:100%; height:100%; object-fit:cover; border-radius:8px;">
                                {% endif %}
                            </div>

                            <div class="details-annonce-profil">
                                <p><strong>{{ fav.ville }} – {{ fav.commune }}</strong></p>
                                <p>
                                    {% if fav.superficie %}
                                        <strong>{{ fav.superficie }} m²</strong> |
                                    {% endif %}
                                    <strong>{{ fav.prix|number_format(0, '.', ' ') }} F CFA</strong>
                                </p>
                            </div>
                        </a>

                        <div class="actions-annonce-profil">
                            <a href="{{ path('app_annonce_favori', {id: fav.id}) }}" class="lien-modifier">
                                Retirer des favoris
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
            
        </section>



    {% else %}
        <p>Vous devez être connecté pour voir votre profil.</p>
    {% endif %}

    <section class="bloc-suppression-compte">
        <form method="post" action="{{ path('app_user_delete') }}" 
              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ? Cette action est irréversible.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
            <button type="submit" class="bouton-suppression-compte">
                Supprimer mon compte
            </button>
        </form>
    </section>

</main>
{% endblock %}