{% extends 'base.html.twig' %}

{% block title %} Ayitate Homme Page {% endblock %}

{% block body %}
<main class="page-a-propos">
    <div class="conteneur-a-propos">
        
        <!-- En-tête -->
        <section class="entete-page">
            <h1 class="titre-page">À propos d'Ayitate</h1>
            <p class="sous-titre-page">Qui sommes-nous ?</p>
        </section>

        <!-- Notre histoire -->
        <section class="section-contenu">
            <h2 class="titre-section">Notre histoire</h2>
            <p class="texte-contenu">
                <strong>Ayitate</strong> est née d'une expérience personnelle marquante.
                 Membre de la <em>diaspora ivoirienne</em>, notre fondateur a lui-même tenté d'acheter des terrains 
                 à distance, sans réseau solide sur place. Cette tentative s'est soldée par des arnaques, 
                 comme cela arrive malheureusement à beaucoup d'acheteurs.
            </p>
            <p class="texte-contenu">
                Face à l'<strong>insécurité juridique du secteur foncier ivoirien</strong> - où seulement 1% des terrains sont immatriculés 
                - et après avoir mené ses propres recherches sur le terrain, l'idée d'Ayitate a germé : créer une plateforme pour éviter aux autres les erreurs 
                qu'il avait commises et structurer un environnement plus sécurisant pour tous.
            </p>
        </section>

        <!-- Mission et Vision -->
        <section class="section-contenu">
            <h2 class="titre-section">Mission & Vision</h2>
            
            <div class="grille-mission">
                <article class="carte-mission">
                    <div class="icone-mission mission" aria-hidden="true">M</div>
                    <h3 class="titre-mission">Notre mission</h3>
                    <p class="texte-mission">
                        Mettre en relation des <strong>acteurs du foncier ivoirien</strong>, centraliser des outils 
                        pratiques et construire un réseau de recommandations pour favoriser la 
                        <em>transparence et la sécurité</em> dans toutes les démarches foncières.
                    </p>
                </article>
                <article class="carte-mission">
                    <div class="icone-mission vision" aria-hidden="true">V</div>
                    <h3 class="titre-mission">Notre vision</h3>
                    <p class="texte-mission">
                        Créer un <strong>espace numérique, structuré et accessible</strong> qui accompagne 
                        tous les profils d'utilisateurs dans leurs démarches foncières, qu'ils soient en 
                        <em>Côte d'Ivoire ou à l'étranger</em>.
                    </p>
                </article>
            </div>
        </section>

        <!-- Notre équipe -->
        <section class="section-contenu">
            <h2 class="titre-section">Notre équipe d'experts</h2>
            <p class="texte-contenu">
                Une équipe passionnée et expérimentée, composée d'<strong>experts en immobilier, 
                    en technologie et en données</strong>, tous unis par la même vision : 
                    transformer l'expérience immobilière en Côte d'Ivoire.
            </p>
            
            <div class="grille-equipe">
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo de Bobin Pierre"></div>
                    <h3 class="nom-membre">Bobin Pierre</h3>
                    <p class="poste-membre">Fondateur & CEO</p>
                    <p class="bio-membre">Visionnaire et entrepreneur passionné par 
                        l'innovation notamment, dans le secteur immobilier ivoirien.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo de Bobin Charles"></div>
                    <h3 class="nom-membre">Bobin Charles</h3>
                    <p class="poste-membre">CTO</p>
                    <p class="bio-membre">Expert en développement et architecture technique, 
                        responsable de l'infrastructure technologique de la plateforme.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo d'Abedjinan Ange"></div>
                    <h3 class="nom-membre">Abedjinan Ange</h3>
                    <p class="poste-membre">Développeur Full Stack</p>
                    <p class="bio-membre">Développeur polyvalent maîtrisant les technologies front-end et back-end
                         pour créer des expériences utilisateur optimales.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo d'Abedjinan Landry"></div>
                    <h3 class="nom-membre">Abedjinan Landry</h3>
                    <p class="poste-membre">Développeur Full Stack</p>
                    <p class="bio-membre">Spécialiste du développement web moderne, contribuant à l'évolution 
                        continue de nos solutions techniques.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo d'Abedjinan Gilles"></div>
                    <h3 class="nom-membre">Abedjinan Gilles</h3>
                    <p class="poste-membre">Data Scientist</p>
                    <p class="bio-membre">Expert en analyse de données et intelligence artificielle, 
                        optimisant les recommandations et insights de la plateforme.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo de Bobin Kevin"></div>
                    <h3 class="nom-membre">Bobin Kevin</h3>
                    <p class="poste-membre">Directeur des Partenariats Financiers</p>
                    <p class="bio-membre">Ancien directeur de la BACI, il développe les partenariats financiers 
                        et accompagne nos clients dans leurs projets de financement immobilier.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo de Koko Frédéric"></div>
                    <h3 class="nom-membre">Koko Frédéric</h3>
                    <p class="poste-membre">Ingénieur d'Affaires</p>
                    <p class="bio-membre">Spécialiste du développement commercial et de la 
                        gestion des partenariats pour l'expansion d'Ayitate.</p>
                </article>
                
                <article class="carte-membre">
                    <div class="photo-membre" role="img" aria-label="Photo de Bamba Djibril"></div>
                    <h3 class="nom-membre">Bamba Djibril</h3>
                    <p class="poste-membre">Consultant</p>
                    <p class="bio-membre">Conseiller expert en stratégie immobilière, 
                        apportant son expertise sectorielle.
                    </p>
                </article>
            </div>
        </section>

    </div>
</main>
{% endblock %}