{% extends 'base.html.twig' %}

{% block title %} Ayitate Homme Page {% endblock %}

{% block body %}     <!-- OK -->
    <!-- Section Première -->
        <section class="section-accueil">
            <div class="conteneur-accueil">
                
                <!-- Texte à gauche -->
                <article class="texte-accueil">
                    <h1 class="titre-accueil">
                        Trouvez votre bien<br>
                        immobilier en Côte d'Ivoire
                    </h1>

                    <p class="sous-titre-accueil">
                        La plateforme immobilière qui simplifie vos projets
                        d'achat, de location et de vente.
                    </p>

                    <!-- Liste de chiffres clés -->
                    <ul class="liste-chiffres">
                        <li class="chiffre">
                            <strong class="valeur">12,450</strong>
                            <span class="libelle">Biens disponibles</span>
                        </li>
                        <li class="chiffre">
                            <strong class="valeur">8,234</strong>
                            <span class="libelle">Clients satisfaits</span>
                        </li>
                        <li class="chiffre">
                            <strong class="valeur">31</strong>
                            <span class="libelle">Régions couvertes</span>
                        </li>
                    </ul>
                </article>

                <!-- Pour le futur formulaire -->
                <aside class="bloc-formulaire">
                    <!-- ( A voir plus tard ) -->
                </aside>
                
            </div>
        </section>

    <!-- Section Section : Map/Villes -->
        <section class="section-villes">

            <div class="entete-section">
                <h2 class="titre-section">Explorez par ville</h2>
                <p class="sous-titre-section">Sélectionnez une ville pour voir les biens disponibles</p>
            </div>

            <div class="conteneur-villes">

                <div class="grille-villes">

                    <button class="carte-ville">
                        <div class="nom-ville">Abidjan</div>
                        <div class="compte-biens">4,521 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">Yamoussoukro</div>
                        <div class="compte-biens">892 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">Bouaké</div>
                        <div class="compte-biens">1,234 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">San-Pédro</div>
                        <div class="compte-biens">756 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">Korhogo</div>
                        <div class="compte-biens">543 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">Daloa</div>
                        <div class="compte-biens">678 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">Man</div>
                        <div class="compte-biens">432 biens</div>
                    </button>

                    <button class="carte-ville">
                        <div class="nom-ville">Gagnoa</div>
                        <div class="compte-biens">389 biens</div>
                    </button>
                </div>

            </div>

        </section>

<!-- Section : Terrains à vendre -->
    <section class="section-terrains">

    <div class="header-terrains">
        <h2>Terrains à vendre ( J'ai FAIT UNE ERREUR A CORRIGER)</h2>
        <a href="#" class="lien-tous">Voir tous les terrains</a>
    </div>

    <div class="grid-terrains">
        {% set count = 0 %}
        {% for annonceVente in annoncesVente %}
        {% if annonceVente.natureBien.nom == 'Terrain' and count < 3 %}
            <div class="card-terrain">
            <div class="photo-terrain">
            <!-- Pour la phot plus tard -->
            </div>
            <div class="info-terrain">
                <p><strong>{{ annonceVente.ville }} – {{ annonceVente.commune }}</strong></p>
                <p>
                <strong>{{ annonceVente.superficie }} m²</strong> | <strong>{{ annonceVente.prix|number_format(0, '.', ' ') }} F CFA</strong>
                </p>
            </div>
            </div>
            {% set count = count + 1 %}
        {% endif %}
        {% endfor %}
    </div>
    
    </section>

    <!-- Section : Maisons à louer -->
        <section class="section-terrains">

        <div class="header-terrains">
            <h2>Appartement à louer</h2>
            <a href="#" class="lien-tous">Voir toutes les maisons</a>
        </div>

        <div class="grid-terrains">
            {% set count = 0 %}
            {% for annonceLocation in annoncesLocation %}
            {% if annonceLocation.natureBien.nom == 'Appartement' and count < 3 %}
                <div class="card-terrain">
                <div class="photo-terrain">
                <!-- Pour la phot plus tard -->
                </div>
                <div class="info-terrain">
                    <p><strong>{{ annonceLocation.ville }} – {{ annonceLocation.commune }}</strong></p>
                    <p>
                    <strong>{{ annonceLocation.superficie }} m²</strong> | <strong>{{ annonceLocation.prix|number_format(0, '.', ' ') }} F CFA</strong>
                    </p>
                </div>
                </div>
                {% set count = count + 1 %}
            {% endif %}
            {% endfor %}
        </div>
        
        </section>

    <!-- Section : Colocation -->
        <section class="section-terrains">

        <div class="header-terrains">
            <h2>Maison en colocation</h2>
            <a href="#" class="lien-tous">Voir toutes les colocations</a>
        </div>

        <div class="grid-terrains">
            {% set count = 0 %}
            {% for annonceColocation in annoncesColocation %}
            {% if annonceColocation.natureBien.nom == 'Maison' and count < 3 %}
                <div class="card-terrain">
                <div class="photo-terrain">
                <!-- Pour la phot plus tard -->
                </div>
                <div class="info-terrain">
                    <p><strong>{{ annonceColocation.ville }} – {{ annonceColocation.commune }}</strong></p>
                    <p>
                    <strong>{{ annonceColocation.superficie }} m²</strong> | <strong>{{ annonceColocation.prix|number_format(0, '.', ' ') }} F CFA</strong>
                    </p>
                </div>
                </div>
                {% set count = count + 1 %}
            {% endif %}
            {% endfor %}
        </div>
        
        </section>

    <!-- Section : Vendez ou louez votre bien facilement -->
        <section class="section-publication">

            <div class="conteneur-publication">

                <div class="contenu-publication">
                    
                    <div class="texte-publication">
                        <h2 class="titre-publication">Vendez ou louez votre bien facilement ( A FAIRE Renvoyer page connexion si pas connecter)</h2>
                        <p class="description-publication">Publiez votre annonce en moins de 2 minutes et touchez des milliers d'acheteurs potentiels</p>
                    </div>
                        <a href="{{ path('app_annonce_new') }}" class="bouton-publication">
                            ➕ Publier une annonce gratuitement
                        </a>
                </div>
            </div>

        </section>
    
    <!-- Section : Blog -->
            <section class="section-blog">

            <div class="conteneur-blog">
                <div class="entete-blog">
                <h2 class="titre-blog">Le Blog Ayitate</h2>
                <p class="sous-titre-blog">Découvrez nos derniers articles juridiques et nos conseils déco</p>
                </div>

                <!--  Experts -->
                <div class="section-categorie">
                <div class="entete-categorie">
                    <a href="{{ path('conseil_expert') }}" class="lien-categorie-header">Voir tous les conseils →</a>
                </div>
                <div class="grille-categorie">
                    <!-- Article Expert -->
                 {% if articlesJuridique is empty %}  
                        <p> Aucun article pour le moment.</p>
                {% else %}

                    {% for articleJuridique in articlesJuridique %}

                        <article class="carte-article">

                        <div class="image-article">
                            <span class="tag-article tag-expert">Expert</span>                     
                        </div>

                        <div class="contenu-article">

                            <h3 class="titre-article"> {{ articleJuridique.titre}}</h3>
                            <p class="extrait-article">{{ articleJuridique.article|slice(0,150)|nl2br ~ '...' }}</p>
                        
                            <div class="meta-article">
                                <span class="date-article">             
                                  {% if articleJuridique.auteur.pseudo %}
                                         {{ articleJuridique.auteur.pseudo }}
                                    {% elseif articleJuridique.auteur.prenom or articleJuridique.auteur.nom %}
                                        {{ articleJuridique.auteur.prenom }} {{ articleJuridique.auteur.nom }}
                                    {% else %}
                                        {{ articleJuridique.auteur.email }}
                                    {% endif %}                                  
                                    | {{ articleJuridique.dateCreation|date('d/m/Y')}}</span>
                                <a href="{{ path('blog_show', {id: articleJuridique.id}) }}" class="lien-lire">Lire l'article</a>
                            </div>
                        </div>
                    {% endfor %}
                    </article>
                {% endif %}
                </div>
                </div>




            <!--  Déco -->
                <div class="section-categorie">

                        <div class="entete-categorie">
                            <a href="{{ path('conseil_deco') }}" class="lien-categorie-header">Voir tous les articles déco →</a>
                        </div>

                    <div class="grille-categorie">
                        
                        <!-- Article Déco  -->
                        {% if articlesDeco is empty %}
                        
                            <p> Aucun article pour le moment.</p>

                        {% else %}

                            {% for articleDeco in articlesDeco %}

                                <article class="carte-article">
                                    <div class="image-article">
                                        <span class="tag-article tag-deco">Déco</span>
                                    </div>

                                    <div class="contenu-article">

                                        <h3 class="titre-article">  {{ articleDeco.titre}} </h3>
                                        <p class="extrait-article"> {{ articleDeco.article|slice(0,150)|nl2br ~ '...' }}</p>
                                        
                                        <div class="meta-article">
                                            <span class="date-article"> 
                                                {% if articleDeco.auteur.pseudo %}
                                                    {{ articleDeco.auteur.pseudo }}
                                                {% elseif articleDeco.auteur.prenom or articleDeco.auteur.nom %}
                                                    {{ articleDeco.auteur.prenom }} {{ articleDeco.auteur.nom }}
                                                {% else %}
                                                    {{ articleDeco.auteur.email }}
                                                {% endif %}

                                                | {{ articleDeco.dateCreation|date('d/m/Y')}}</span>

                                            <a href="{{ path('blog_show', {id: articleDeco.id}) }}" class="lien-lire">Lire l'article</a>
                                        </div>

                                    </div>

                                {% endfor %}

                            </article>

                         {% endif %}
                    </div>
                </div>

        </div>

        </section>

    <!-- Section : Rejoignez notre forum -->
        <section class="section-forum">

        <div class="conteneur-forum">
            <div class="entete-forum">
            <h2 class="titre-forum">Rejoignez notre communauté immobilière</h2>
            <p class="sous-titre-forum">Échangez avec d'autres passionnés d'immobilier sur tous vos projets et questions</p>
            </div>

            <div class="contenu-forum">
            <div class="avantages-forum">
                <div class="avantage-item">
                <h3>Conseils et entraide</h3>
                <p>Posez vos questions et obtenez des réponses de la communauté</p>
                </div>
                <div class="avantage-item">
                <h3>Retours d'expérience</h3>
                <p>Profitez de l'expérience d'autres membres</p>
                </div>
                <div class="avantage-item">
                <h3>Discussions ouvertes</h3>
                <p>Échangez librement sur tous les sujets immobiliers</p>
                </div>
            </div>
            
            <div class="action-forum">
                <a href="{{ path('app_forum')}}" class="bouton-forum">Accéder au forum</a>
                <p class="info-forum">Inscription gratuite • Plus de 2000 membres actifs</p>
            </div>
            </div>
        </div>

        </section>

{% endblock %}
