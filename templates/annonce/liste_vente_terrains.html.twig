{% extends 'base.html.twig' %}

{% block title %}Terrains à vendre{% endblock %}

{% block body %}
<main id="page-liste-terrains" class="page-liste-annonces">

  <section class="entete-liste-annonces">
    <h1>Terrains à vendre</h1>
  </section>

  <div class="conteneur-liste-annonces">

    {# FILTRE  #}
    <aside class="zone-filtres-annonces" aria-label="Filtres de recherche">
      <h2 class="titre-filtres-annonces">Affiner la recherche</h2>

      {{ form_start(form, { method: 'GET' }) }}
        <fieldset class="bloc-filtre">
          <legend>Localisation</legend>
          <div class="champ-filtre">
            {{ form_label(form.ville, 'Ville') }}
            {{ form_widget(form.ville, {'attr': {'placeholder': 'Ex: Abidjan'}}) }}
             {{ form_errors(form.ville) }}
          </div>
          <div class="champ-filtre">
            {{ form_label(form.commune, 'Commune') }}
            {{ form_widget(form.commune, {'attr': {'placeholder': 'Ex: Cocody'}}) }}
          </div>
        </fieldset>

        <fieldset class="bloc-filtre">
          <legend>Budget</legend>
          <div class="champ-filtre">
            {{ form_label(form.prixMin, 'Prix min (FCFA)') }}
            {{ form_widget(form.prixMin) }}
          </div>
          <div class="champ-filtre">
            {{ form_label(form.prixMax, 'Prix max (FCFA)') }}
            {{ form_widget(form.prixMax) }}
          </div>
        </fieldset>

        <fieldset class="bloc-filtre">
          <legend>Caractéristiques</legend>
          <div class="champ-filtre">
            {{ form_label(form.superficieMin, 'Superficie min (m²)') }}
            {{ form_widget(form.superficieMin) }}
          </div>
          <div class="champ-filtre">
            {{ form_label(form.superficieMax, 'Superficie max (m²)') }}
            {{ form_widget(form.superficieMax) }}
          </div>
          <div class="champ-filtre case-cocher">{{ form_row(form.constructible) }}</div>
          <div class="champ-filtre case-cocher">{{ form_row(form.viabilise) }}</div>
        </fieldset>

        <div class="boutons-formulaire">
            <button type="submit" class="bouton-valider-filtres">Valider</button>
            <a href="{{ path('app_annonce_liste_vente_terrains') }}" class="bouton-reset-filtres">Effacer</a>
        </div>
        
      {{ form_end(form) }}
    </aside>

    {# ----------- LISTE DES ANNONCES ----------- #}
    <section class="zone-grille-annonces">
      {% if annonces is not empty %}
        {% for annonce in annonces %}
          <a href="{{ path('annonce_show', { id: annonce.id }) }}" class="carte-annonce-liste">
            <div class="bloc-image-annonce">
              {% if annonce.photos|length > 0 %}
                <img src="{{ asset('uploads/annonces/' ~ annonce.photos|first.url) }}"
                     alt="Terrain à {{ annonce.ville }}">
              {% else %}
                <div class="image-vide-annonce"></div>
              {% endif %}
            </div>
            <div class="bloc-infos-annonce">
              <p class="texte-lieu"><strong>{{ annonce.ville }} – {{ annonce.commune }}</strong></p>
              <p class="texte-prix">
                {% if annonce.superficie %}
                  <strong>{{ annonce.superficie }} m²</strong> |
                {% endif %}
                <strong>{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</strong>
              </p>
              <p class="texte-reference">Réf : {{ annonce.reference }}</p>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <p>Aucun terrain à vendre pour le moment.</p>
      {% endif %}
    </section>
  </div>

  <div class="liens-voir-aussi">
    <a href="{{ path('app_annonce_liste_vente_maisons') }}">Maisons à vendre</a>
    <a href="">Appartements à vendre</a>
  </div>

</main>
{% endblock %}