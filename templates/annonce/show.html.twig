{% extends 'base.html.twig' %}

{% block title %}Détail de l'annonce{% endblock %}

{% block body %}

<section class="fiche-annonce">

    {#  BANDEAU PHOTO #}
        <div class="bandeau-photos">
            {% set nbPhotos = annonce.photos|length %}

            {% if nbPhotos == 0 %}
                <div class="photo-vide">Aucune photo disponible</div>

            {% elseif nbPhotos == 1 %}
                <div class="grande-photo">
                    <img src="{{ asset('uploads/annonces/' ~ annonce.photos[0].url) }}" alt="Photo du bien">
                </div>

            {% elseif nbPhotos == 2 %}
                <div class="grille-photos grille-2">
                    {% for photo in annonce.photos|slice(0, 2) %}
                        <img src="{{ asset('uploads/annonces/' ~ photo.url) }}" alt="Photo du bien">
                    {% endfor %}
                </div>

            {% elseif nbPhotos >= 3 %}
                <div class="grille-photos grille-3">
                    <div class="photo-principale">
                        <img src="{{ asset('uploads/annonces/' ~ annonce.photos[0].url) }}" alt="Photo principale du bien">
                    </div>

                    <div class="colonne-secondaire">
                        <div class="photo-secondaire">
                            <img src="{{ asset('uploads/annonces/' ~ annonce.photos[1].url) }}" alt="Photo secondaire">
                        </div>

                        <div class="photo-secondaire">
                            <img src="{{ asset('uploads/annonces/' ~ annonce.photos[2].url) }}" alt="Photo secondaire">
                            {% if nbPhotos > 3 %}
                                <button class="btn-voir-photos">Voir les photos</button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>


    {# Contenu principal en 2 colonnes  #}

    <div class="contenu-annonce">

        {# Colonne gauche : texte #}
        <div class="colonne-gauche">

            <header class="entete-annonce">
                <h1 class="titre-annonce">
                    {{ annonce.commune }} – {{ annonce.natureBien.nom }} – {{ annonce.superficie }} m²
                </h1>
                <h2 class="ville-annonce">{{ annonce.ville }}</h2>
            </header>

            {# logos/icônes à venir ultérieurement #}

            <article class="bloc-description">
                <h3 class="titre-description">{{ annonce.titre }}</h3>
                <p class="texte-description">{{ annonce.description }}</p>
                <p class="ref-annonce">Référence : {{ annonce.reference }}</p>
                <p class="contact-annonce">
                    Contact : 0{{annonce.tel}}
                </p>
                <p class="date-publication">
                    {{ annonce.datePublication|date('d/m/Y') }}
                </p>
            </article>

            {% if annonce.natureBien.nom in ['Maison', 'Appartement'] %}
                <section class="bloc-descriptif-detaille">
                    <h2 class="titre-descriptif">Descriptif détaillé</h2>
                    <table class="tableau-descriptif">
                        <tbody>
                            {% if annonce.surfaceHabitable %}
                                <tr>
                                    <th>Surface habitable</th>
                                    <td>{{ annonce.surfaceHabitable }} m²</td>
                                </tr>
                            {% endif %}

                            {% if annonce.garage or annonce.terrasse %}
                                <tr>
                                    <th>Garage</th>
                                    <td>{{ annonce.garage ? 'Oui' : 'Non' }}</td>
                                    <th>Terrasse</th>
                                    <td>{{ annonce.terrasse ? 'Oui' : 'Non' }}</td>
                                </tr>
                            {% endif %}

                            {% if annonce.anneeConstruction %}
                                <tr>
                                    <th>Année de construction</th>
                                    <td>{{ annonce.anneeConstruction }}</td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </section>
            {% endif %}
        </div>


        {#  Colonne droite : prix + actions  #}
        <aside class="colonne-droite">
            <div class="bloc-prix-actions">
                <p class="prix-annonce">{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</p>

                <div class="actions-annonce">
                    <button class="btn-contact">Contacter le vendeur</button>
                    <button class="btn-sauvegarde">Sauvegarder</button>
                    <button class="btn-partager">Partager</button>
                </div>
            </div>
        </aside>

    </div>


    {# 

    <div class="bloc-secondaire">
        <section class="autres-annonces">
            <h3>Autre(s) annonce(s) de cette personne</h3>
        </section>

        <section class="annonces-similaires">
            <h3>Ces annonces peuvent vous intéresser</h3>
        </section>
    </div>
    #}

</section>

{% endblock %}