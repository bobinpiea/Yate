{# templates/annonce/show.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Détail de l'annonce{% endblock %}

{% block body %}
<section class="fiche-annonce">

    {#  A METTRE EN PLACE  #}
    <div class="bloc-photos">
        <img src="" alt="Photos du bien">
        <button class="btn-voir-photos">Voir les photos</button>
        
        {# ici je veux qu'on voit toutes les photos de l'annonce #}
    </div>

    {#  2. En-tete (sans le titre de l'annonce #}
    <div class="entete-annonce">
        <h1 class="titre-annonce">
            {{ annonce.commune }} - 
            {{ annonce.natureBien.nom }} -
            {{ annonce.superficie }} m²
        </h1>
        <h2 class="ville-annonce">{{ annonce.ville }}</h2>
    </div>

    {#  Action (à mettre) à  Droite  #}
    <div class="bloc-prix-actions">
        <p class="prix-annonce">{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</p>
        <div class="actions-annonce">
            <button class="btn-contact">Contacter le vendeur</button>
            <button class="btn-sauvegarde">Sauvegarder</button>
            <button class="btn-partager">Partager</button>
        </div>
    </div>

    {#  Résumé Infos Rapides + Image #}
    <div class="infos-rapides">
        <p class="type-bien">{{ annonce.natureBien.nom }}</p>
        <p class="superficie">{{ annonce.superficie }} m²</p>
    </div>

    {# Descrition / Détail  #}
    <div class="bloc-description">
        <h3 class="titre-description">{{ annonce.titre }}</h3>
        <p class="texte-description">{{ annonce.description }}</p>
        <p class="ref-annonce">Référence : {{ annonce.reference }}</p>
        <a href=""> Contact : + 225 (Rajouter un champ numéro de télephone dans l'entité Annonce)</a>
        <p class="date-publication">Publié le : {{ annonce.datePublication|date('d/m/Y') }}</p>
    </div>

    {#
        Pourquoi pas faire un tableau avec les titres de propriété :
        ACD - Attestation villageoise - Lettre d'attribution - ACP 
    #}

    {#  Tableau descriptif (si Maison ou Appartement)  #}
    {% if annonce.natureBien.nom in ['Maison', 'Appartement'] %}
    <div class="bloc-descriptif-detaille">
        <h2 class="titre-descriptif">Descriptif détaillé</h2>

        <table class="tableau-descriptif">
            <tbody>
                {% if annonce.surfaceHabitable %}
                    <tr>
                        <th>Surface habitable</th>
                        <td>{{ annonce.surfaceHabitable }} m²</td>
                    </tr>
                {% endif %}

                {% if annonce.garage or annonce.terrasse %}
                    <tr>
                        <th>Garage</th>
                        <td>{{ annonce.garage ? 'Oui' : 'Non' }}</td>
                        <th>Terrasse</th>
                        <td>{{ annonce.terrasse ? 'Oui' : 'Non' }}</td>
                    </tr>
                {% endif %}

                {% if annonce.anneeConstruction %}
                    <tr>
                        <th>Année de construction</th>
                        <td>{{ annonce.anneeConstruction }}</td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
    {% endif %}

    {# ---------- 7. Blocs à venir --------- #}
    <div class="bloc-a-venir">
        <h4>Localisation (A voir si c'est possible)</h4> {# A faire plus tard #}
        <h4>Autre(s) annonce(s) de cette personne</h4> {# A faire plus tard #}
        <h4>Ces annonces peuvent vous intéresser</h4> {# A faire plus tard #}
    </div>

</section>
{% endblock %}