{% extends 'base.html.twig' %}

{% block title %}Déposer une annonce immobilière - Ayitate{% endblock %}

{% block body %}
<main class="contenu-annonce">

  <header class="entete-page">
    <h1 class="titre-principal">Déposer une annonce immobilière</h1>
    <p class="texte-intro">Remplissez les informations ci-dessous pour proposer votre bien.</p>
  </header>

  {# 🔔 Messages flash (succès / erreur) #}
  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="flash-message flash-{{ label }}">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {{ form_start(form, { attr: { id: 'annonce-form', class: 'formulaire-annonce' } }) }}

    {# Étape 1 : choix transaction + nature #}
    <section class="bloc-formulaire" id="step-1">
      <div class="ligne-formulaire">
        <div class="colonne-formulaire">
          {{ form_row(form.transaction, {
            label: 'Vous souhaitez effectuer une :',
            attr: {'data-ajax-trigger': 1}
          }) }}
        </div>
        <div class="colonne-formulaire">
          {{ form_row(form.nature, {
            label: 'Quelle est la nature du bien :',
            attr: {'data-ajax-trigger': 1}
          }) }}
        </div>
      </div>

      <div class="zone-suivant">
        <button type="button" id="btn-suivant" class="bouton-secondaire">Suivant</button>
      </div>
    </section>

    {# Étape 2 : champs + upload photos #}
    <section class="bloc-formulaire" id="step-2" style="display:none;">
      
      <div id="details-fields"></div>

      <section class="bloc-photos-etape2">
        <h2 class="titre-section">Photos du bien</h2>
        <p class="texte-aide">Veuillez ajouter entre <strong>1 et 10 photos</strong> (formats : JPG, PNG, WebP).</p>
        {{ form_row(form.photosUpload, {
          label: 'Sélectionnez vos photos'
        }) }}
      </section>

      <div class="zone-bouton">
        <button type="submit" class="bouton-principal">Publier l'annonce</button>
      </div>
    </section>

  {{ form_end(form) }}

</main>

{# Script pour gérer les étapes #}
<script>
(function(){
  const form        = document.getElementById('annonce-form');
  const selectTrans = document.querySelector('[name$="[transaction]"]');
  const selectNature= document.querySelector('[name$="[nature]"]');

  const step2       = document.getElementById('step-2');
  const btnNext     = document.getElementById('btn-suivant');
  const detailsBox  = document.getElementById('details-fields');

  btnNext.addEventListener('click', function(){
    if (!selectTrans.value || !selectNature.value) {
      alert('Merci de sélectionner un type de transaction et une nature de bien.');
      return;
    }

    const formData = new FormData(form);
    fetch('{{ path("annonce_preview") }}', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: formData
    })
    .then(r => r.json())
    .then(({ form: html }) => {
      detailsBox.innerHTML = html;
      step2.style.display = 'block';
      step2.scrollIntoView({ behavior: 'smooth' });
    })
    .catch(() => {
      alert('Impossible de charger les champs. Réessayez.');
    });
  });
})();
</script>
{% endblock %}