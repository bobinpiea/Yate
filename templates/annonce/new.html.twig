{% extends 'base.html.twig' %}

{% block title %}Déposer une annonce immobilière - Ayitate{% endblock %}

{% block body %}
<main class="page-annonce">

  <section class="zone-intro-annonce">
    <h1 class="titre-annonce">Déposer une annonce immobilière</h1>
    <p class="texte-annonce">Remplissez les informations ci-dessous pour proposer votre bien.</p>
  </section>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div class="alerte-message alerte-{{ label }}">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {{ form_start(form, { attr: { id: 'formulaire-annonce', class: 'bloc-formulaire-annonce' } }) }}

    {# Étape 1 : choix transaction + nature #}
    <section class="etape-formulaire" id="etape-1">
      <div class="zone-selecteurs">

        <div class="bloc-selecteur">
          {{ form_label(form.transaction, 'Vous souhaitez effectuer une :') }}
          {{ form_widget(form.transaction, { attr: {'data-ajax-trigger': 1} }) }}
          <div class="message-erreur" style="display:none;">
            {{ form_errors(form.transaction) }}
          </div>
        </div>

        <div class="bloc-selecteur">
          {{ form_label(form.nature, 'Quelle est la nature du bien :') }}
          {{ form_widget(form.nature, { attr: {'data-ajax-trigger': 1} }) }}
          <div class="message-erreur" style="display:none;">
            {{ form_errors(form.nature) }}
          </div>
        </div>

      </div>

      <div class="zone-bouton-suivant">
        <button type="button" id="btn-suivant" class="btn-secondaire">Suivant</button>
      </div>
    </section>

    {# Étape 2 : champs + upload photos #}
    <section class="etape-formulaire" id="etape-2" style="display:none;">
      <div id="zone-details"></div>

      <section class="bloc-photos">
        <h2 class="titre-section">Photos du bien</h2>
        <p class="texte-aide">
          Veuillez ajouter entre <strong>1 et 10 photos</strong> 
          (formats : JPG, PNG, WebP).
        </p>

        <div class="zone-upload">
          {{ form_label(form.photosUpload, 'Sélectionnez vos photos') }}
          {{ form_widget(form.photosUpload) }}
          <div class="message-erreur" style="display:none;">
            {{ form_errors(form.photosUpload) }}
          </div>
        </div>
      </section>

      <div class="zone-bouton-publier">
        <button type="submit" class="btn-principal">Publier l'annonce</button>
      </div>
    </section>

  {{ form_end(form) }}

</main>

<script>
(function() {
  const form = document.getElementById('formulaire-annonce');
  const btnNext = document.getElementById('btn-suivant');
  const etape2 = document.getElementById('etape-2');
  const detailsBox = document.getElementById('zone-details');
  const selectTrans = document.querySelector('[name$="[transaction]"]');
  const selectNature = document.querySelector('[name$="[nature]"]');

  // Étape 1
  btnNext.addEventListener('click', function() {
    if (!selectTrans.value || !selectNature.value) {
      alert('Merci de sélectionner un type de transaction et une nature de bien.');
      return;
    }

    const formData = new FormData(form);
    fetch('{{ path("annonce_preview") }}', {
      method: 'POST',
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
      body: formData
    })
    .then(response => response.json())
    .then(({ form: html }) => {
      detailsBox.innerHTML = html;
      etape2.style.display = 'block';
      etape2.scrollIntoView({ behavior: 'smooth' });
    })
    .catch(() => alert('Impossible de charger les champs. Réessayez.'));
  });

  // Étape 2 : soumission complète du formulaire
  form.addEventListener('submit', function(event) {
    console.log("🟢 Soumission du formulaire Ayitate détectée");
    document.querySelectorAll('.message-erreur').forEach(el => el.style.display = 'none');
    // Rien ne bloque : le navigateur envoie le POST normalement à Symfony
  });
})();
</script>
{% endblock %}