{% extends 'base.html.twig' %}
{% block title %}Déposer une annonce immobilière{% endblock %}

{% block body %}
<main>

  <h1>Déposer une annonce immobilière</h1>

  {% for label, messages in app.flashes %}
    {% for message in messages %}
      <div>{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {{ form_start(form, {
    method: 'POST',
    attr: { 
      id: 'formulaire-annonce', 
      enctype: 'multipart/form-data',
      'data-turbo': 'false'
    }
  }) }}

  <!-- Étape 1 -->
  <section id="etape-1">
    <h2>Étape 1 : Sélection</h2>

    <div>
      {{ form_label(form.transaction, 'Type de transaction :') }}
      {{ form_widget(form.transaction, { attr: {'data-ajax-trigger': 1} }) }}
      {{ form_errors(form.transaction) }}
    </div>

    <div>
      {{ form_label(form.nature, 'Nature du bien :') }}
      {{ form_widget(form.nature, { attr: {'data-ajax-trigger': 1} }) }}
      {{ form_errors(form.nature) }}
    </div>

    <button type="button" id="bouton-suivant" data-turbo="false">Suivant</button>
  </section>

  <!-- Étape 2 -->
  <section id="etape-2" style="display:none;">
    <h2>Étape 2 : Détails du bien</h2>

    <div id="zone-details"></div>

    <h3>Photos</h3>
    <div>
      {{ form_label(form.photosUpload, 'Photos :') }}
      {{ form_widget(form.photosUpload) }}
      {{ form_errors(form.photosUpload) }}
    </div>

    <button type="submit">Publier l'annonce</button>
  </section>

{{ form_row(form._token) }}
{{ form_end(form, {render_rest: false}) }}
</main>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('formulaire-annonce');
  const etape1 = document.getElementById('etape-1');
  const etape2 = document.getElementById('etape-2');
  const zoneDetails = document.getElementById('zone-details');
  const boutonSuivant = document.getElementById('bouton-suivant');
  const selectTransaction = document.querySelector('[name*="[transaction]"]');
  const selectNature = document.querySelector('[name*="[nature]"]');

  boutonSuivant.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    
    if (!selectTransaction.value || !selectNature.value) {
      alert("Merci de sélectionner un type de transaction et une nature de bien.");
      return;
    }

    zoneDetails.innerHTML = "<p>⏳ Chargement des champs...</p>";
    etape2.style.display = "block";
    boutonSuivant.disabled = true;

    const formData = new FormData(form);

    // Utiliser XMLHttpRequest au lieu de fetch pour éviter Turbo
    const xhr = new XMLHttpRequest();
    xhr.open('POST', '{{ path("annonce_preview") }}', true);
    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
    
    xhr.onload = function() {
      if (xhr.status === 200) {
        try {
          const data = JSON.parse(xhr.responseText);
          if (data.form) {
            zoneDetails.innerHTML = data.form;
            etape1.style.display = "none";
          } else {
            throw new Error('Pas de formulaire dans la réponse');
          }
        } catch(err) {
          console.error('Erreur parsing JSON:', err);
          zoneDetails.innerHTML = "<p style='color:red'>❌ Erreur de format de réponse</p>";
          boutonSuivant.disabled = false;
        }
      } else {
        zoneDetails.innerHTML = "<p style='color:red'>❌ Erreur serveur: " + xhr.status + "</p>";
        boutonSuivant.disabled = false;
      }
    };
    
    xhr.onerror = function() {
      zoneDetails.innerHTML = "<p style='color:red'>❌ Erreur réseau</p>";
      boutonSuivant.disabled = false;
    };
    
    xhr.send(formData);
  });
});
</script>
{% endblock %}