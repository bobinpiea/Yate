{% extends 'base.html.twig' %}

{% block title %}Annonces à vendre - Ayitate{% endblock %}

{% block body %}
  <section class="liste-annonces">
    <h1>Annonces disponibles à l'achat</h1>

    {% if annonces is empty %}
      <p>Aucune annonce disponible pour le moment.</p>
    {% else %}
      <div class="grille-annonces">
        {% for annonce in annonces %}
          <div class="carte-annonce">
            <h2>{{ annonce.titre }}</h2>
            <p>{{ annonce.ville }} - {{ annonce.commune }}</p>
            <p><strong>{{ annonce.prix }} FCFA</strong></p>
            {# Lien vers page détail (à faire plus tard) #}
            <a href="#">Voir les détails</a>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </section>
{% endblock %}