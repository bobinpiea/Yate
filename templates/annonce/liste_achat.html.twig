{% extends 'base.html.twig' %}

{% block title %}Annonces à vendre - Ayitate{% endblock %}

{% block body %}
<main class="liste-annonces">

    <h1 class="titre-principal">Annonces Ventes Immobilières</h1>

    {% if annonces is empty %}
        <p class="message-vide">Aucune annonce disponible pour le moment.</p>
    {% else %}

        <!-- Bloc : Terrains à vendre -->
        <div class="bloc-annonce">
            <div class="en-tete-bloc">
                <h2>Terrains à vendre</h2>
                <a href="{{ path('app_annonce_liste_vente_terrains') }}" class="voir-plus">Voir tous les terrains</a>
            </div>

            <div class="grille-annonces">
                {% set count = 0 %}
                {% for annonce in annonces %}
                    {% if annonce.natureBien.nom == 'Terrain' and count < 8 %}
                        <a href="{{ path('annonce_show', { id: annonce.id }) }}" class="carte-annonce">
                            <div class="image-annonce">
                                {% if annonce.photos|length > 0 %}
                                    <img src="{{ asset('uploads/annonces/' ~ annonce.photos|first.url) }}" 
                                         alt="Photo de {{ annonce.titre }}" 
                                         style="width:100%; height:100%; object-fit:cover; border-radius:8px;">
                                {% endif %}
                            </div>
                            <div class="infos-annonce">
                                <p><strong>{{ annonce.ville }} – {{ annonce.commune }}</strong></p>
                                <p>
                                    <strong>{{ annonce.superficie }} m²</strong> |
                                    <strong>{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</strong>
                                </p>
                            </div>
                        </a>
                        {% set count = count + 1 %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <!-- Bloc : Maisons à vendre -->
        <div class="bloc-annonce">
            <div class="en-tete-bloc">
                <h2>Maisons à vendre</h2>
                <a href="{{ path('app_annonce_liste_vente_maisons') }}" class="lien-tous">Voir toutes les maisons</a>
            </div>

            <div class="grille-annonces">
                {% set count = 0 %}
                {% for annonce in annonces %}
                    {% if annonce.natureBien.nom == 'Maison' and count < 8 %}
                        <a href="{{ path('annonce_show', { id: annonce.id }) }}" class="carte-annonce"> 
                            <div class="carte-annonce">
                                <div class="image-annonce">
                                    {% if annonce.photos|length > 0 %}
                                        <img src="{{ asset('uploads/annonces/' ~ annonce.photos|first.url) }}" 
                                             alt="Photo de {{ annonce.titre }}" 
                                             style="width:100%; height:100%; object-fit:cover; border-radius:8px;">
                                    {% endif %}
                                </div>
                                <div class="infos-annonce">
                                    <p><strong>{{ annonce.ville }} – {{ annonce.commune }}</strong></p>
                                    <p>
                                        <strong>{{ annonce.superficie }} m²</strong> | 
                                        <strong>{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</strong>
                                    </p>
                                    <p>Réf : {{ annonce.reference }}</p>
                                </div>
                            </div>
                        </a>      
                        {% set count = count + 1 %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

        <!-- Bloc : Appartements à vendre -->
        <div class="bloc-annonce">
            <div class="en-tete-bloc">
                <h2>Appartements à vendre</h2>
                <a href="#" class="voir-plus">Voir tous les appartements</a>
            </div>

            <div class="grille-annonces">
                {% set count = 0 %}
                {% for annonce in annonces %}
                    {% if annonce.natureBien.nom == 'Appartement' and count < 8 %}
                        <a href="{{ path('annonce_show', { id: annonce.id }) }}" class="carte-annonce">             
                            <div class="carte-annonce">
                                <div class="image-annonce">
                                    {% if annonce.photos|length > 0 %}
                                        <img src="{{ asset('uploads/annonces/' ~ annonce.photos|first.url) }}" 
                                             alt="Photo de {{ annonce.titre }}" 
                                             style="width:100%; height:100%; object-fit:cover; border-radius:8px;">
                                    {% endif %}
                                </div>
                                <div class="infos-annonce">
                                    <p><strong>{{ annonce.ville }} – {{ annonce.commune }}</strong></p>
                                    <p>
                                        <strong>{{ annonce.superficie }} m²</strong> | 
                                        <strong>{{ annonce.prix|number_format(0, '.', ' ') }} F CFA</strong>
                                    </p>
                                </div>
                            </div>
                        </a>  
                        {% set count = count + 1 %}
                    {% endif %}
                {% endfor %}
            </div>
        </div>

    {% endif %}
</main>
{% endblock %}