{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
    <main class="formulaire-connexion">

        <form method="post"> {# Pour envoyer les données au serveur#}
            {% if error %} {# Si une erreur est détectée alors, elle est affichée ex: erreur de MDP #}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3">
                    Vous êtes connecté en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Déconnexion</a>
                </div>
            {% endif %}

            <h1 class="h3 mb-3 font-weight-normal">Connexion</h1>

            <label for="email">Email</label>
            <input type="email" value="{{ last_username }}" name="email" id="email" class="form-control" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" name="password" id="password" class="form-control" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                {# CSRF (Cross Site Request Forgery) empêche les attaques sur le formulaire #}

            <div class="checkbox mb-3">
                <input type="checkbox" name="_remember_me" id="_remember_me">
                <label for="_remember_me">Se souvenir de moi</label>
            </div>

            <button class="btn btn-lg btn-primary" type="submit">
                Se connecter
            </button>
        </form>

        <p class="texte-inscription">
            <a href="{{ path('app_register') }}">Créer un compte</a>
        </p>
    </main>
{% endblock %}