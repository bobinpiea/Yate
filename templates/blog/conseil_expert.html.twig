{% extends 'base.html.twig' %}

{% block title %}Conseils D'expert{% endblock %}

{% block body %}
<main>
    <h1>Conseils D'expert</h1>

    {% if blogs is empty %}
        <p>Aucun article pour le moment.</p>
    {% else %}
        <ul class="articles-grid">
            {% for blog in blogs %}
                <li class="article-card">
                    <strong>{{ blog.titre }}</strong><br>
                    {{ blog.article|slice(0, 150) ~ '...' }}<br>
                    <em>
                        {% if blog.auteur.pseudo %}
                            {{ blog.auteur.pseudo }}
                        {% elseif blog.auteur.prenom or blog.auteur.nom %}
                            {{ blog.auteur.prenom }} {{ blog.auteur.nom }}
                        {% else %}
                            {{ blog.auteur.email }}
                        {% endif %}
                        le {{ blog.dateCreation|date('d/m/Y') }}
                    </em>

                    <a href="{{ path('blog_show', {id: blog.id}) }}">Lire la suite</a>
                    
                    {% if app.user and app.user.id == blog.auteur.id %}
                        <div class="actions">
                            <a href="{{ path('blog_edit', { id: blog.id }) }}">Modifier</a>
                            
                            <form method="post" action="{{ path('blog_delete', { id: blog.id }) }}" 
                                style="display:inline" 
                                onsubmit="return confirm('Voulez-vous vraiment supprimer cet article ?');">

                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ blog.id) }}">
                                <button type="submit">Supprimer</button>
                            </form>
                        </div>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</main>
{% endblock %}