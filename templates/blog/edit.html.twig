{% extends 'base.html.twig' %}

{% block stylesheets %}
  
{% endblock %}

{% block title %}Écrire un nouvel article{% endblock %}

{% block body %}
<main>
  <h1 class="titre-blog">Écrire un nouvel article</h1>

  <div class="formulaire-article">
    {{ form_start(form) }}

      <div class="champ-formulaire">
        {{ form_label(form.titre, "Titre de l’article") }}
        {{ form_widget(form.titre, {'attr': {'class': 'input input--lg'}}) }}
      </div>

      <div class="champ-formulaire">
        {{ form_label(form.article, "Contenu de l’article") }}
        {{ form_widget(form.article, {'attr': {'class': 'textarea-article'}}) }}
      </div>

      <div class="champ-formulaire champ--center">
        {{ form_label(form.categorie, "Catégorie") }}
        {{ form_widget(form.categorie, {'attr': {'class': 'select select--sm'}}) }}
      </div>

      <div class="champ-formulaire champ--center">
        {{ form_label(form.url, "Lien (optionnel)") }}
        {{ form_widget(form.url, {'attr': {'class': 'input input--md'}}) }}
      </div>

      <div class="actions">
        <button type="submit" class="btn-submit">Publier</button>
      </div>

    {{ form_end(form) }}
  </div>
</main>
{% endblock %}