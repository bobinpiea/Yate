<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Ayitate : plateforme immobilière sur Abidjan et la Côte d’Ivoire.
         Retrouvez annonces, conseils d’experts et forum dédié à l’immobilier.">
        <meta name="author" content="Ayitate - Pierre-André Bobin">
        <meta name="robots" content="index, follow">
        <meta name="theme-color" content="#2563eb">
        <meta name="keywords" content="immobilier, Côte d’Ivoire, Abidjan, maisons à vendre,
        appartements à louer, colocation, terrain, annonces immobilières">


        <title>{% block title %} Ayitate — Côte d’Ivoire Immobilier{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        
        {% block stylesheets %}     
             <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>

<header>
    <!-- Ligne 1 : Logo + CTA + Actions utilisateurs -->
    <div class="header-top">
        <!-- Logo -->
        <div class="logo">
            <a href="{{ path('app_home')}}"><span>Ayitate</span></a>
        </div>

        <!-- CTA : Déposer une annonce -->
        <div class="cta-annonce">
            <a href="{{ path('app_annonce_new') }}">Déposer une annonce</a>
        </div>

        <!-- Bouton menu mobile -->
        <button class="burger-toggle" aria-label="Ouvrir le menu">&#9776;</button>

        <!-- Actions utilisateur -->
        <nav class="user-actions" aria-label="Actions utilisateur">
            <ul>
                <li class="forum"><a href="{{ path('app_forum')}}">Forum</a></li>
                <li><a href="#favoris">Favoris</a></li>
                <li><a href="{{ path('app_message_reception') }}">Messages</a></li>
    
                {% if app.user is defined and app.user %}
                    <li class="connexion">
                        <a href="{{ path('app_profile') }}">Mon profil</a>
                    </li>
                    <li class="inscription">
                        <a href="{{ path('app_logout') }}">Déconnexion</a>
                    </li>
                {% else %}
                    <li class="connexion">
                        <a href="{{ path('app_login') }}">Connexion</a>
                    </li>
                    <li class="inscription">
                        <a href="{{ path('app_register') }}">Inscription</a>
                    </li>
                {% endif %}
                
            </ul>
        </nav>
    </div>
    
    <!-- Ligne 2 : Navigation principale -->
    <nav class="main-nav" aria-label="Navigation principale">
        <ul>
            <li><a href="{{ path('app_annonce_liste_achat') }}">Achat</a></li>
            <li><a href="{{ path('app_annonce_liste_location') }}">Location</a></li>
            <li><a href="{{ path('app_annonce_liste_colocation') }}">Colocation</a></li>
            <li><a href="#evenements">Événements</a></li>
            <li><a href="{{ path('conseil_expert') }}">Conseils d'experts</a></li>
            <li><a href="{{ path('conseil_deco') }}">Déco</a></li>
            <li><a href="#annuaire">Annuaire Pro</a></li>
          <!--    <li><a href="#evenements">Services de déménagement</a></li> -->
            <li><a href="#Immobiliers">Carte</a></li>
             <!-- Ligne <li><a href="#Simulateur">Simulateurs</a></li> -->
        </ul>
    </nav>

    <!-- Ligne 3 : Actions rôles (auteur / admin) -->
    {% if app.user %}
    <nav class="role-actions" aria-label="Actions rôles">
        <ul>
            {% if is_granted('ROLE_AUTEUR') %}
                <li><a href="{{ path('blog_new') }}">Écrire un article</a></li>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <li><a href="{{ path('app_nature_bien_index') }}">Types de biens</a></li>
                <li><a href="{{ path('app_transaction_index') }}">Types de transactions</a></li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const toggleButton = document.querySelector('.burger-toggle');
    const userActions = document.querySelector('.user-actions');
    const mainNav = document.querySelector('.main-nav');
    const roleActions = document.querySelector('.role-actions');


    if (toggleButton) {
      toggleButton.addEventListener('click', function () {

        userActions?.classList.toggle('open');
        mainNav?.classList.toggle('open');
        roleActions?.classList.toggle('open');
      });
    }
  });
</script>

</header>

    {# Bloc global pour afficher les messages flash #}
    {% for label, messages in app.flashes %}
        <div class="flash flash-{{ label }}" role="status" aria-live="polite">
            {% for message in messages %}
                <p>{{ message }}</p>
            {% endfor %}
        </div>
    {% endfor %}
    
        {% block body %}

        
        
        {% endblock %}

    <!-- FOOTER Structure: 4 colonnes + copyright -->
    <footer>
        <!-- PARTIE HAUTE : Grille 4 colonnes -->

        <!-- Premiere ligne -->
        <div class="footer-content">

            <!-- Colonne 1/4 -->
            <section class="footer-section">
                <h2>À propos</h2>
                <ul>
                    <li> <a href="{{ path('app_about') }}">Qui sommes-nous ?</a> </li>
                    <li><a href="{{ path('app_nous_rejoindre') }}">Nous rejoindre</a></li>
                    <li><a href="{{ path('app_nos_engagements') }}">Nos engagements</a></li>
                    <li> <a href="{{ path('app_boite_idees') }}">Boîte à idées</a> </li>
                </ul>
            </section>

            <!-- Colonne 2/4 -->
            <section class="footer-section">
                <h2>Services</h2>
                <nav aria-label="Services footer">
                    <ul>
                        <li><a href="{{ path('app_annonce_liste_achat') }}">Acheter</a></li>
                        <li><a href="{{ path('app_annonce_liste_location') }}">Louer</a></li>
                        <li><a href="{{ path('app_annonce_liste_colocation') }}">Colocation</a></li>
                        <li><a href="{{ path('app_annonce_new') }}">Déposer une annonce</a></li>
                    </ul>
                </nav>
            </section>

            <!-- Colonne 3/4 -->
            <section class="footer-section">
                <h2>Ressources</h2>
                <nav aria-label="Ressources footer">
                    <ul>
                        <li><a href="{{ path('conseil_expert') }}">Conseils d'experts</a></li>
                        <li><a href="{{ path('conseil_deco') }}">Blog Déco</a></li>
                        <li><a href="#annuaire">Annuaire Pro</a></li>
                    </ul>
                </nav>
            </section>

            <!-- Colonne 4/4 -->
            <section class="footer-section">
                <h2>Contact</h2>
                <address>
                    <ul>
                        <li>Abidjan, Côte d'Ivoire</li>
                        <li>+225 07 00 00 00 00</li>
                        <li>contact@ayitate.ci</li>
                    </ul>
                </address>
            </section>

        </div>

        <!-- PARTIE BASSE : Copyright  -->
        <section class="footer-bottom">
            <p>
                © 2025 Ayitate. Tous droits réservés. |
                <a href="{{ path('app_legal') }}">Mentions légales</a> |
                <a href="{{ path('app_privacy') }}">Politique de confidentialité</a>
            </p>
        </section>
    </footer>


    </body>
</html>
