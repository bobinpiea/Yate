<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Ayitate : plateforme immobilière sur Abidjan et la Côte d’Ivoire.
            Retrouvez annonces, conseils d’experts et forum dédié à l’immobilier">

        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
              <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>

        <header>
            <!-- Première ligne : logo + CTA + actions utilisateurs -->
            <div>
                <!-- Logo -->
                <div>
                    <a href="{{ path('app_home')}}"><span>Ayitate</span></a>
                </div>

                <!-- Bouton Déposer une annonce -->
                <div>
                    <a href="#publier">Déposer une annonce</a>
                </div>

                <!-- Les actions de l'utilisateur -->
                <nav aria-label="Actions utilisateur">
                    <ul>
                        <li><a href=" {{ path('app_forum')}}">Forum</a></li>
                        <li><a href="#favoris">Favoris</a></li>
                        <li><a href="#messages">Messages</a></li>

                    {% if app.user %}
                        <li><a href="{{ path('app_profile')}}">Mon profil</a></li>
                        <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    {% else %}
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <li><a href="{{ path('app_register')}}">Inscription</a></li>
                    {% endif %}

                    </ul>
                </nav>
            </div>
            
            <!-- Seconde Ligne : navigation des rubriques -->
            <nav aria-label="Navigation principale">
                <ul>
                    <li><a href="#achat">Achat</a></li>
                    <li><a href="#location">Location</a></li>
                    <li><a href="#colocation">Colocation</a></li>
                    <li><a href="#evenements">Événements</a></li>
                    <li><a href="{{ path('conseil_expert') }}">Conseils d'experts</a></li>
                    <li><a href="{{ path('conseil_deco') }}">Déco</a></li>
                    <li><a href="#annuaire">Annuaire Pro</a></li>
                    <li><a href="#evenements">Services de déménagement</a></li>
                    <li><a href="#Immobiliers">Immobiliers</a></li>
                    <li><a href="#Simulateur">Simulateurs</a></li>
                </ul>
            </nav>
            
            {% if app.user %}
            <nav aria-label="Actions auteur">
                <ul>
                    <li><a href="{{ path('blog_new') }}">Écrire un article</a></li>
                </ul>
            </nav>
            {% endif %}
        </header>

        
        {% block body %}
        
        {% endblock %}

    <!-- FOOTER Structure: 4 colonnes + copyright -->
    <footer>
        <!-- PARTIE HAUTE : Grille 4 colonnes -->

        <!-- Premiere ligne -->
        <div class="footer-content">

            <!-- Colonne 1/4 -->
            <section class="footer-section">
                <h2>À propos</h2>
                <ul>
                    <li> <a href="{{ path('app_about') }}">Qui sommes-nous ?</a> </li>
                    <li><a href="{{ path('app_nous_rejoindre') }}">Nous rejoindre</a></li>
                    <li><a href="{{ path('app_nos_engagements') }}">Nos engagements</a></li>
                    <li> <a href="{{ path('app_boite_idees') }}">Boîte à idées</a> </li>
                </ul>
            </section>

            <!-- Colonne 2/4 -->
            <section class="footer-section">
                <h2>Services</h2>
                <nav aria-label="Services footer">
                    <ul>
                        <li><a href="#achat">Acheter</a></li>
                        <li><a href="#location">Louer</a></li>
                        <li><a href="#colocation">Colocation</a></li>
                        <li><a href="#publier">Déposer une annonce</a></li>
                    </ul>
                </nav>
            </section>

            <!-- Colonne 3/4 -->
            <section class="footer-section">
                <h2>Ressources</h2>
                <nav aria-label="Ressources footer">
                    <ul>
                        <li><a href="#conseils">Conseils d'experts</a></li>
                        <li><a href="#blog">Blog Déco</a></li>
                        <li><a href="#annuaire">Annuaire Pro</a></li>
                    </ul>
                </nav>
            </section>

            <!-- Colonne 4/4 -->
            <section class="footer-section">
                <h2>Contact</h2>
                <address>
                    <ul>
                        <li>Abidjan, Côte d'Ivoire</li>
                        <li>+225 07 00 00 00 00</li>
                        <li>contact@ayitate.ci</li>
                    </ul>
                </address>
            </section>

        </div>

        <!-- PARTIE BASSE : Copyright  -->
        <section class="footer-bottom">
            <p>
                © 2025 Ayitate. Tous droits réservés. |
                <a href="{{ path('app_legal') }}">Mentions légales</a> |
                <a href="{{ path('app_privacy') }}">Politique de confidentialité</a>
            </p>
        </section>
    </footer>


    </body>
</html>
