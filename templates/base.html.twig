<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}

              <link rel="stylesheet" href="{{ asset('css/style.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>

        <header>

            <!-- Première ligne : logo + CTA + actions utilisateurs -->
            <div>

                <!-- Logo -->
                <div>
                    <a href="{{ path('app_home')}}"><span>Ayitate</span></a>
                </div>

                <!-- Bouton Déposer une annonce -->
                <div>
                    <a href="#publier">Déposer une annonce</a>
                </div>

                <!-- Les actions de l'utilisateur -->
                <div>
                    <ul>
                        <li><a href="#forum">Forum</a></li>
                        <li><a href="#favoris">Favoris</a></li>
                        <li><a href="#messages">Messages</a></li>
                        <li><a href="{{ path('app_login') }}">Connexion</a></li>
                        <li><a href="{{ path('app_register')}}">Inscription</a></li>
                    </ul>
                </div>

            </div>
            
            <!-- Seconde Ligne : navigation des rubriques -->
            <nav>
                <ul>
                    <li><a href="#achat">Achat</a></li>
                    <li><a href="#location">Location</a></li>
                    <li><a href="#colocation">Colocation</a></li>
                    <li><a href="#evenements">Événements</a></li>
                    <li><a href="#conseils">Conseils d’experts</a></li>
                    <li><a href="#Deco">Déco</a></li>
                    <li><a href="#annuaire">Annuaire Pro</a></li>
                    <li><a href="#evenements">Services de déménagement</a></li>
                </ul>
            </nav>
        </header>
        
        {% block body %}
        
        {% endblock %}

        <footer>
            <!-- Haut du footer : colonnes -->
            <div class="footer-content">

                <!-- Colonne 1 -->
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul>
                        <li> <a href="{{ path('app_about') }}">Qui sommes-nous ?</a> </li>
                        <li><a href="{{ path('app_nous_rejoindre') }}">Nous rejoindre</a></li>
                        <li><a href="{{ path('app_nos_engagements') }}">Nos engagements</a></li>
                        <li> <a href="{{ path('app_boite_idees') }}">Boîte à idées</a> </li>
                    </ul>
                </div>

                <!-- Colonne 2 -->
                <div class="footer-section">
                    <h4>Services</h4>
                    <ul>
                        <li><a href="#achat">Acheter</a></li>
                        <li><a href="#location">Louer</a></li>
                        <li><a href="#colocation">Colocation</a></li>
                        <li><a href="#publier">Déposer une annonce</a></li>
                    </ul>
                </div>

                <!-- Colonne 3 -->
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul>
                        <li><a href="#conseils">Conseils d’experts</a></li>
                        <li><a href="#blog">Blog Déco</a></li>
                        <li><a href="#annuaire">Annuaire Pro</a></li>
                    </ul>
                </div>

                <!-- Colonne 4 -->
                <div class="footer-section">
                    <h4>Contact</h4>
                    <ul>
                        <li>Abidjan, Côte d’Ivoire</li>
                        <li>+225 07 00 00 00 00</li>
                        <li>contact@ayitate.ci</li>
                    </ul>
                </div>

            </div>

            <!-- Bas du footer -->
            <div class="footer-bottom">
                <p>
                    © 2025 Ayitate. Tous droits réservés. |
                    <a href="{{ path('app_legal') }}">Mentions légales</a> |
                    <a href="{{ path('app_privacy') }}">Politique de confidentialité</a>
                </p>
            </div>
        </footer>

    </body>
</html>
